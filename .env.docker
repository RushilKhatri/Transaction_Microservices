# .env.docker — Environment variables for docker-compose
# These are injected into all services at runtime.
# Replace placeholder values with real secrets in Phase 6 (Vault).

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=banking
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=banking_pass

# ── Shared by Flask services ───────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=banking
DB_USER=banking_user
DB_PASSWORD=banking_pass

# ── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=dev-jwt-secret-change-in-vault

# ── Service-to-service URLs (Docker Compose service names) ─────────────────
FRAUD_SERVICE_URL=http://fraud-detection-service:5002
TRANSACTION_SERVICE_URL=http://transaction-service:5001
NOTIFICATION_SERVICE_URL=http://notification-service:5003

# ── Internal service-to-service JWT auth ───────────────────────────────────
INTERNAL_SERVICE_ID=fraud-detection-service
INTERNAL_JWT_AUDIENCE=internal-services
INTERNAL_JWT_TTL_SECONDS=120
TRUSTED_INTERNAL_SERVICES=fraud-detection-service
INTERNAL_REQUIRED_SCOPE=internal_history_read

# ── Vault (Phase 6) ────────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root

# ── Frontend build args ────────────────────────────────────────────────────
VITE_TRANSACTION_URL=http://localhost:5001
VITE_FRAUD_URL=http://localhost:5002
VITE_NOTIFICATION_URL=http://localhost:5003
